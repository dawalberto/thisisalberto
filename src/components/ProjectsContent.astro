---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import Layout from '../layouts/Layout.astro';
import ProjectCard from './ProjectCard.astro';
import SEOSchema from './SEOSchema.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = (await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`)))
    .sort((a, b) => a.data.order - b.data.order);

const description = lang === 'es'
    ? 'Proyectos personales de Alberto García Sola: MacroCalc (calculadora nutricional con IA on-device en WebGPU), Jjoin (Electron + Vue) y Podcaster (React + TypeScript). Aplicaciones web reales con código abierto.'
    : "Personal projects by Alberto García Sola: MacroCalc (nutrition calculator with on-device AI on WebGPU), Jjoin (Electron + Vue) and Podcaster (React + TypeScript). Real-world open source web apps.";

const keywords = lang === 'es'
    ? 'proyectos web, portfolio proyectos, React projects, TypeScript, Astro, Electron, Vue, MacroCalc, Jjoin, Podcaster, IA on-device, WebGPU, Transformers.js, desarrollo web, aplicaciones web open source'
    : 'web projects, portfolio projects, React projects, TypeScript, Astro, Electron, Vue, MacroCalc, Jjoin, Podcaster, on-device AI, WebGPU, Transformers.js, web development, open source web applications';

const projectsBaseUrl = lang === 'en' ? '/' : '/es/';
const breadcrumbs = [
    { name: lang === 'es' ? 'Inicio' : 'Home', url: projectsBaseUrl },
    { name: lang === 'es' ? 'Proyectos' : 'Projects', url: lang === 'en' ? '/projects' : '/es/projects' },
];

const itemListSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": lang === 'es' ? 'Proyectos de Alberto García Sola' : "Alberto García Sola's Projects",
    "numberOfItems": projects.length,
    "itemListElement": projects.map((project, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "item": {
            "@type": "SoftwareApplication",
            "name": project.data.title,
            "description": project.data.description,
            "applicationCategory": "WebApplication",
            "operatingSystem": "Web",
            "url": project.data.demo || project.data.repo,
            "codeRepository": project.data.repo,
            "keywords": project.data.tags?.join(', '),
            "author": { "@type": "Person", "name": "Alberto García Sola" }
        }
    }))
};
---

<Layout
    title={t('projects.pageTitle')}
    description={description}
    keywords={keywords}
    lang={lang}
>
    <SEOSchema type="CollectionPage" lang={lang} breadcrumbs={breadcrumbs} pageName={t('projects.pageTitle')} pageDescription={description} slot="schema" />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} is:inline slot="schema" />
    <div class="container mx-auto px-3 sm:px-4 pb-8 sm:pb-12 md:pb-20">
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold font-heading text-slate-900 mb-8 sm:mb-12 md:mb-16 animate-fade-in-down uppercase tracking-tighter leading-tight">
            {t('projects.title.prefix')} 
            <span class="relative inline-block">
                {t('projects.title.highlight')}
                <span class="absolute bottom-1 sm:bottom-2 left-0 w-full h-2 sm:h-3 bg-accent -z-10 -rotate-2"></span>
            </span>
        </h1>
        <div class="flex flex-col animate-fade-in-up">
            {projects.map((project, index) => (
                <ProjectCard project={project} lang={lang} index={index} />
            ))}
        </div>
    </div>
</Layout>

<style>
    .animate-fade-in-down {
        animation: fadeInDown 0.6s ease-out;
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out;
    }
    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
